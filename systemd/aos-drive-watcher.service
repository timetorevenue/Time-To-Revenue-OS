# Revisit: when the Drive capture/runtime contract changes.
[Unit]
Description=TTROS bounded read-only Drive Changes source capture
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ttros-core
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AOS_DISABLE_TELEMETRY=1
Environment=TTROS_BRAIN_AUTOPUSH=0
Environment=TTROS_CODEX_NO_PUSH=1
Environment=TTROS_SHARED_BRAIN_WRITE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/opt/ttros-core/.venv/bin/python /opt/ttros-core/tools/drive_watcher.py --pages 2 --batch 5
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
MemoryMax=1G
CPUQuota=50%
