# Revisit: when Memory Exchange transport or importer command changes. Last touched: 2026-11-24.
[Unit]
Description=TTROS deterministic Memory Exchange import poll
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ttros-core
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AOS_DISABLE_TELEMETRY=1
Environment=TTROS_BRAIN_AUTOPUSH=0
Environment=TTROS_CODEX_NO_PUSH=1
Environment=TTROS_SHARED_BRAIN_WRITE=1
Environment=TTROS_SHARED_BRAIN_SUBMIT=1
EnvironmentFile=%h/.config/ttros-memory-exchange.env
ExecStart=/opt/ttros-core/.venv/bin/python /opt/ttros-core/tools/memory_exchange_import.py --imported ${TTROS_MEMORY_IMPORTED} --rejected ${TTROS_MEMORY_REJECTED} --move
# The vault is on the Windows mount. A single run includes verified indexing and filing.
TimeoutStartSec=15min
