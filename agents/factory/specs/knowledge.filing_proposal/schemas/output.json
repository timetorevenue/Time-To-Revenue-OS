{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge.filing_proposal output",
  "description": "A proposal only. Nothing is written; 'file' carries one brain.write_proposal effect, 'hold_for_review' carries none.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "area", "slug", "target", "frontmatter", "reasons", "proposes_write"],
  "properties": {
    "action": {"enum": ["file", "hold_for_review"]},
    "area": {"type": "string", "pattern": "^$|^[a-z0-9][a-z0-9_/-]{0,119}$"},
    "slug": {"type": "string", "pattern": "^$|^[a-z0-9][a-z0-9-]{0,79}$"},
    "target": {"type": "string", "pattern": "^$|^business_brain:[a-z0-9][a-z0-9_/-]*\\.md$"},
    "frontmatter": {
      "type": "object", "additionalProperties": false, "required": ["type", "source", "date", "entities", "sensitivity"],
      "properties": {
        "type": {"type": "string"}, "source": {"type": "string"}, "date": {"type": "string"},
        "entities": {"type": "array", "items": {"type": "string"}}, "sensitivity": {"type": "string"}
      }
    },
    "reasons": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 200}},
    "proposes_write": {"type": "boolean"}
  }
}
