{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crm.meeting_extract output",
  "description": "Every decision, action item, pain point and next step carries a quote that was found word for word in the cited source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "date", "summary", "decisions", "action_items", "pain_points", "open_questions", "next_step", "unverified_dropped", "caveats", "sources"],
  "properties": {
    "title": {"type": "string"},
    "date": {"type": "string"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 600},
    "decisions": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/backed"}},
    "action_items": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["task", "owner", "due", "quote", "sources"],
        "properties": {
          "task": {"type": "string", "minLength": 3, "maxLength": 300},
          "owner": {"description": "Empty when the notes do not say who.", "type": "string", "maxLength": 80},
          "due": {"description": "In the notes' own words; empty when none is given.", "type": "string", "maxLength": 80},
          "quote": {"type": "string", "minLength": 5, "maxLength": 400},
          "sources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "pain_points": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/backed"}},
    "open_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "next_step": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/backed"}]},
    "unverified_dropped": {"description": "Items the model returned that code removed because their quote is not in the notes.", "type": "integer", "minimum": 0},
    "caveats": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 200}},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "ref"],
        "properties": {"id": {"type": "string"}, "ref": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "backed": {
      "type": "object", "additionalProperties": false, "required": ["text", "quote", "sources"],
      "properties": {
        "text": {"type": "string", "minLength": 3, "maxLength": 300},
        "quote": {"type": "string", "minLength": 5, "maxLength": 400},
        "sources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
