{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crm.followup_draft output",
  "description": "A draft for Casey. Every point listed was taken from the meeting record and carries that record's source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["to", "subject", "body", "points", "used", "word_count", "status", "proposes_draft", "artifact"],
  "properties": {
    "to": {
      "type": "object", "additionalProperties": false, "required": ["name", "company", "email"],
      "properties": {"name": {"type": "string"}, "company": {"type": "string"}, "email": {"type": "string"}}
    },
    "subject": {"type": "string", "minLength": 3, "maxLength": 100},
    "body": {"type": "string", "minLength": 80, "maxLength": 2000},
    "points": {
      "description": "The record's facts the email relies on, each with its source.",
      "type": "array", "minItems": 1, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "sources"],
        "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
      }
    },
    "used": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "word_count": {"type": "integer", "minimum": 10},
    "status": {"const": "draft_for_approval"},
    "proposes_draft": {"description": "True when a Gmail draft to the recipient's address is proposed. Nothing is ever sent.", "type": "boolean"},
    "artifact": {"type": "string"}
  }
}
