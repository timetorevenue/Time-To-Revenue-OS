{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crm.meeting_extract input",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "date": {"description": "The day the meeting took place.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "attendees": {
      "description": "People in the meeting. An owner the notes do not name is accepted only if listed here.",
      "type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 2, "maxLength": 80}
    },
    "evidence_refs": {
      "description": "Exact Business Brain or artifact references to the notes or transcript. Never a search.",
      "type": "array", "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(business_brain:|artifact:)[A-Za-z0-9_./#:-]+$"}
    },
    "notes": {
      "description": "Notes or transcript passed inline, each with the reference it should be cited by.",
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "text"],
        "properties": {
          "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$", "maxLength": 300},
          "text": {"type": "string", "minLength": 10, "maxLength": 12000}
        }
      }
    }
  }
}
