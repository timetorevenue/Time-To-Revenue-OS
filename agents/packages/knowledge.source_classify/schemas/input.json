{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge.source_classify input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {"description": "The source's own title or file name, if it has one.", "type": "string", "maxLength": 200},
    "evidence_refs": {
      "description": "One exact Business Brain or artifact reference to the source. Never a search.",
      "type": ["array", "null"], "maxItems": 1,
      "items": {"type": "string", "pattern": "^(business_brain:|artifact:)[A-Za-z0-9_./#:-]+$"}
    },
    "sources": {
      "description": "The source passed inline, with the reference it is known by.",
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "text"],
        "properties": {
          "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$", "maxLength": 300},
          "text": {"type": "string", "maxLength": 12000}
        }
      }
    },
    "known_entities": {
      "description": "Clients, prospects and people TTROS already knows. Only these can be returned as entities.",
      "type": ["array", "null"], "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "type"],
        "properties": {"name": {"type": "string", "minLength": 2, "maxLength": 120}, "type": {"enum": ["client", "prospect", "person", "vendor", "internal"]}}
      }
    }
  }
}
