{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shared.cite_verify input",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_sets"],
  "properties": {
    "claim_sets": {
      "description": "One or more lists of claims; each claim is an object with a 'sources' list of references.",
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "array", "maxItems": 40, "items": {"type": "object", "required": ["sources"],
                "properties": {"sources": {"type": "array", "items": {"type": "string"}}}}}
    },
    "allowed_refs": {"type": ["array", "null"], "items": {"type": "string"}},
    "allowed_signals": {"type": ["array", "null"], "items": {"type": "object", "required": ["url"],
                        "properties": {"url": {"type": "string"}}}}
  }
}
