{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shared.planner input",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "request": {"description": "What Casey asked for, in his words.", "type": "string", "minLength": 8, "maxLength": 1000},
    "records": {
      "description": "The exact records David found for this request. The plan can use only these.",
      "type": ["array", "null"], "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref"],
        "properties": {
          "ref": {"type": "string", "pattern": "^(business_brain:|artifact:)[A-Za-z0-9_./#:-]+$", "maxLength": 300},
          "about": {"description": "One line on what the record is.", "type": "string", "maxLength": 200}
        }
      }
    },
    "people": {
      "description": "The contacts David matched for this request. A follow-up can only be addressed to one of these.",
      "type": ["array", "null"], "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 80},
          "company": {"type": "string", "maxLength": 120},
          "email": {"type": "string", "maxLength": 200, "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}
        }
      }
    }
  }
}
