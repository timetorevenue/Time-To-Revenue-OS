{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research.synthesise output",
  "description": "Every finding carries a quote that was found word for word in the cited source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "summary", "findings", "conflicts", "gaps", "unverified_dropped", "sources"],
  "properties": {
    "question": {"type": "string"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 900},
    "findings": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["claim", "quote", "confidence", "sources"],
        "properties": {
          "claim": {"type": "string", "minLength": 3, "maxLength": 400},
          "quote": {"type": "string", "minLength": 5, "maxLength": 500},
          "confidence": {"enum": ["high", "medium", "low"]},
          "sources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "conflicts": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 3, "maxLength": 400}},
    "gaps": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "unverified_dropped": {"description": "Findings the model returned that code removed because their quote or a figure is not in the cited source.", "type": "integer", "minimum": 0},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "ref"], "properties": {"id": {"type": "string"}, "ref": {"type": "string"}}}
    }
  }
}
