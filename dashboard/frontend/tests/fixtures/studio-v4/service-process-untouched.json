      {
        "type": "ServiceProcess0",
        "props": {
          "id": "ServiceProcess0",
          "text0": "Business Process & Workflow Automation",
          "text1": "Make the work flow.",
          "text2": "We trace how work moves through your business, simplify the steps and build the workflows that keep leads, customers and internal work moving.",
          "styles": {}
        }
      },
      {
        "type": "ServiceProcess1",
        "props": {
          "id": "ServiceProcess1",
          "text0": "When this can help.",
          "text1": "New inquiries sit in inboxes or go unassigned.",
          "text2": "A quote goes out and follow-up depends on someone remembering.",
          "text3": "New clients have to answer the same questions twice.",
          "text4": "Approvals and handoffs take several rounds of chasing.",
          "styles": {}
        }
      },
      {
        "type": "ServiceProcess2",
        "props": {
          "id": "ServiceProcess2",
          "text0": "What we can build with you.",
          "text1": "Customer intake and follow-up",
          "text2": "Capture inquiries from the channels you use, assign an owner, and help your team follow up on leads, quotes and repeat business.",
          "text3": "Onboarding and delivery",
          "text4": "Collect the right information, create tasks, and make ownership clear as work moves from sales to delivery.",
          "text5": "Approvals and recurring admin",
          "text6": "Simplify document routing, reminders and recurring reports. Build in review points and decide what happens when a step needs attention.",
          "styles": {}
        }
      },
      {
        "type": "ServiceProcess3",
        "props": {
          "id": "ServiceProcess3",
          "text0": "How we measure progress.",
          "text1": "Response time, quote follow-up, time spent per handoff and the rate of incomplete requests are useful starting points.",
          "text2": "See how we work ",
          "text3": "Related services",
          "text4": "Inbound-reply systems ",
          "text5": "Prospecting and lead research ",
          "text6": "Inbound call handling ",
          "text7": "See all services",
          "link0": "/how-we-work",
          "link1": "/inbound-reply-system",
          "link2": "/lead-generation-agent",
          "link3": "/ai-voice-agent-setup",
          "link4": "/services",
          "styles": {}
        }
      },
      {
        "type": "ServiceProcess4",
        "props": {
          "id": "ServiceProcess4",
          "text0": "What’s holding your business back?",
          "text1": "Tell us where work gets stuck or opportunities get missed. We’ll talk through what a useful first step could look like.",
          "text2": "Discuss your business ",
          "link0": "/free-assessment",
          "styles": {}
        }
