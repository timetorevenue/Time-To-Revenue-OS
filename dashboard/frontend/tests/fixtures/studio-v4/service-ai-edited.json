      {
        "type": "ServiceAi2",
        "props": {
          "id": "ServiceAi2",
          "text0": "What we can build with you.",
          "text1": "Find the right use cases",
          "text2": "Assess the work, the available information and the risks. Choose tasks with a clear purpose and a way to tell if they improve.",
          "text3": "Build with review and controls",
          "text4": "Develop focused assistants and workflows for tasks such as drafting replies or sorting requests. Define access, review and escalation before rollout.",
          "text5": "Train the team and measure use",
          "text6": "Test with real scenarios, show people how to review outputs, and document the workflow so the team can use and maintain it.",
          "styles": {}
        }
      },
      {
        "type": "ServiceAi3",
        "props": {
          "id": "ServiceAi3",
          "text0": "How we measure progress.",
          "text1": "Check review time, correction rate and adoption. Compare the effort of doing the whole task before and after, including the time people spend checking the output.",
