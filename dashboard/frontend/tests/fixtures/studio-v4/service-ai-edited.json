        "props": {
          "id": "ServiceAi0",
          "text0": "AI Strategy, Implementation & Adoption",
          "text1": "Put AI to work where it helps.",
          "text2": "We find where AI helps with real work, build it into the workflow and train your team to use it well.",
          "styles": {
            "p-1": {
              "fontSize": 22
            }
          }
        }
      },
      {
        "type": "ServiceAi1",
        "props": {
          "id": "ServiceAi1",
          "text0": "When this can help.",
          "text1": "Staff are trying different tools and getting inconsistent results.",
          "text2": "The team spends time finding information or drafting similar replies.",
          "text3": "A pilot looks promising but sits outside how people actually work.",
          "text4": "Nobody is clear what needs review or which information a tool can use.",
          "styles": {}
        }
      },
      {
        "type": "ServiceAi1",
